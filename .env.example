# NOVA Local Configuration (Copy to .env and customize as needed)
NOVA_ENV=development
LOG_LEVEL=INFO

# Gemini API Configuration (Optional; if blank, NOVA uses deterministic MockLLMClient)
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-3.5-flash-lite

# Local Persistence & Simulated Environment Paths
SQLITE_DB_PATH=nova_audit.sqlite
MOCK_ENV_DIR=./mock_state

# Streamlit Dashboard -> FastAPI Gateway URL
NOVA_API_URL=http://127.0.0.1:8000
